# En-têtes Cloudflare Pages. Aucun X-Robots-Tag sur le domaine final : le site doit être indexé.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()

# L'adresse technique *.pages.dev ne doit pas concurrencer maisonclaire-debarras.fr dans Google.
# Ne s'applique PAS au domaine final.
https://maisonclaire.pages.dev/*
  X-Robots-Tag: noindex

# Page : cache court, revalidée à chaque visite
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Polices : jamais modifiées
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images : cache long. Pour remplacer une image, changer son nom de fichier.
/img/*
  Cache-Control: public, max-age=31536000
/logo.svg
  Cache-Control: public, max-age=604800
/logo-dark.svg
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800

# Fichiers pour robots : cache court
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600
